{
  "name": "opencode-v2-sidebar",
  "displayName": "OpenCode V2 Sidebar",
  "description": "Embed the official OpenCode V2 web UI in the VS Code Secondary Side Bar (right side)",
  "version": "0.3.0",
  "publisher": "Polasie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Polasie/opencode-v2-sidebar.git"
  },
  "homepage": "https://github.com/Polasie/opencode-v2-sidebar#readme",
  "bugs": {
    "url": "https://github.com/Polasie/opencode-v2-sidebar/issues"
  },
  "keywords": [
    "opencode",
    "ai",
    "chat",
    "sidebar"
  ],
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:opencodeV2.chatView",
    "onCommand:opencodeV2.focus",
    "onCommand:opencodeV2.reconnect"
  ],
  "contributes": {
    "commands": [
      {
        "command": "opencodeV2.focus",
        "title": "OpenCode V2: Focus Chat"
      },
      {
        "command": "opencodeV2.reconnect",
        "title": "OpenCode V2: Reconnect"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencodeV2",
          "title": "OpenCode V2",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "opencodeV2": [
        {
          "type": "webview",
          "id": "opencodeV2.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode V2 Sidebar",
      "properties": {
        "opencodeV2.groupBy": {
          "type": "string",
          "enum": ["project", "directory", "none"],
          "default": "project",
          "description": "Group sessions in the embedded OpenCode Home page by project or directory. 'none' keeps the official date grouping."
        }
      }
    }
  }
}
